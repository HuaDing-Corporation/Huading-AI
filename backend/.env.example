DATABASE_URL=postgresql+psycopg://huading:huading@localhost:5432/huading
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false
# JWT_SECRET_KEY must be set in every deployed environment.
# Use a high-entropy secret (32+ bytes); do not reuse this comment as a value.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_MAX_BYTES=10485760
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=.local-storage
STORAGE_BUCKET=huading-dev
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1

# ---- Object storage for generated media ----
# Dev can use MinIO/local-compatible S3. Real OmniHuman e2e must point these to
# Volcengine TOS, and ENGINE_S3_PUBLIC_ENDPOINT must be the public endpoint that
# Jimeng can fetch. The worker gives OmniHuman presigned URLs from this public
# endpoint for avatar image/audio inputs.
# Example TOS mode:
#   ENGINE_S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
#   ENGINE_S3_PUBLIC_ENDPOINT=https://tos-s3-cn-beijing.volces.com
#   ENGINE_S3_SECURE=true
#   ENGINE_S3_ACCESS_KEY=<volcengine-ak>
#   ENGINE_S3_SECRET_KEY=<volcengine-sk>
#   ENGINE_S3_BUCKET=huading-media
#   ENGINE_S3_REGION=cn-beijing
#   ENGINE_S3_ADDRESSING_STYLE=virtual
ENGINE_S3_ENDPOINT=
ENGINE_S3_PUBLIC_ENDPOINT=
ENGINE_S3_ACCESS_KEY=
ENGINE_S3_SECRET_KEY=
ENGINE_S3_BUCKET=huading-videos
ENGINE_S3_REGION=cn-beijing
ENGINE_S3_SECURE=true
# MinIO uses path-style; Volcengine TOS requires virtual-hosted-style.
ENGINE_S3_ADDRESSING_STYLE=path
ENGINE_S3_PRESIGN_TTL=900
# Producer name embedded in generated MP4 AIGC metadata.
ENGINE_AIGC_PRODUCER=Huading
# Service provider code for synthetic-label metadata; fill after filing/registration.
ENGINE_LABEL_PROVIDER_CODE=

# ---- Video engine (keys injected here, never hardcoded) ----
ENGINE_LLM_API_KEY=
ENGINE_LLM_BASE_URL=https://api.deepseek.com
ENGINE_LLM_MODEL=deepseek-v4-flash
ENGINE_DASHSCOPE_API_KEY=
ENGINE_DEFAULT_TEMPLATE=1080x1920/static_default.html
# "chrome"/"msedge" to use a system browser; empty = Playwright bundled Chromium
ENGINE_BROWSER_CHANNEL=
ENGINE_RUNTIME_ROOT=
ENGINE_OUTPUT_PREFIX=videos

# ---- Doubao-Seedance video (Volcengine Ark) — text-to-video / image-to-video ----
# Read by the engine video provider and scripts/run_seedance.py. Never hardcode.
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-260128
# Same provider for the API/worker (seedance_t2v / seedance_i2v video_mode).
ENGINE_SEEDANCE_API_KEY=
ENGINE_SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ENGINE_SEEDANCE_MODEL=doubao-seedance-2-0-260128
ENGINE_SEEDANCE_REQUEST_TIMEOUT_SECONDS=120
ENGINE_SEEDANCE_POLL_INTERVAL_SECONDS=5
ENGINE_SEEDANCE_TIMEOUT_SECONDS=600

# ---- Jimeng OmniHuman avatar video (Volcengine CV API) ----
# Access/secret keys come from Volcengine IAM. Do not commit real values.
# Real e2e also requires public object URLs for image/audio (TOS or tunnel);
# localhost MinIO cannot be fetched by Jimeng.
ENGINE_OMNIHUMAN_ACCESS_KEY=
ENGINE_OMNIHUMAN_SECRET_KEY=
ENGINE_OMNIHUMAN_REGION=cn-north-1
ENGINE_OMNIHUMAN_REQUEST_TIMEOUT_SECONDS=120
ENGINE_OMNIHUMAN_POLL_INTERVAL_SECONDS=5
ENGINE_OMNIHUMAN_TIMEOUT_SECONDS=600

# ---- Doubao Seed-TTS (Volcengine OpenSpeech) ----
# Optional. When appid/access token are empty, avatar_talk keeps using edge-tts.
# Fill these to synthesize speech through Seed-TTS with real timestamps.
ENGINE_DOUBAO_TTS_APPID=
ENGINE_DOUBAO_TTS_ACCESS_TOKEN=
# Optional newer auth mode. If set, provider sends X-Api-Key instead of appid/access token.
ENGINE_DOUBAO_TTS_API_KEY=
ENGINE_DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
ENGINE_DOUBAO_TTS_DEFAULT_VOICE=zh_male_m191_uranus_bigtts
ENGINE_DOUBAO_TTS_REQUEST_TIMEOUT_SECONDS=60
# Default false avoids audible Seed-TTS watermark tails; set true only to force provider watermarking.
ENGINE_DOUBAO_TTS_AIGC_WATERMARK=false

# ---- Doubao voice clone (MegaTTS purchased speaker slots) ----
ENGINE_DOUBAO_VOICE_CLONE_APPID=
ENGINE_DOUBAO_VOICE_CLONE_ACCESS_TOKEN=
ENGINE_DOUBAO_VOICE_CLONE_RESOURCE_ID=volc.megatts.voiceclone
ENGINE_DOUBAO_VOICE_CLONE_ENDPOINT=https://openspeech.bytedance.com/api/v1/mega_tts/audio/upload
ENGINE_DOUBAO_VOICE_CLONE_STATUS_ENDPOINT=https://openspeech.bytedance.com/api/v1/mega_tts/status
ENGINE_DOUBAO_VOICE_CLONE_REQUEST_TIMEOUT_SECONDS=60
ENGINE_DOUBAO_VOICE_CLONE_POLL_INTERVAL_SECONDS=2
ENGINE_DOUBAO_VOICE_CLONE_TIMEOUT_SECONDS=60
ENGINE_DOUBAO_VOICE_CLONE_MODEL_TYPE=4
ENGINE_DOUBAO_VOICE_CLONE_TTS_RESOURCE_ID=seed-icl-2.0

# ---- APIMart image/video generation (default photo and video_gen providers) ----
# Do not commit real keys. APIMart edit/reference requests require
# public/presigned input URLs; set ENGINE_S3_PUBLIC_ENDPOINT to a URL APIMart
# can fetch. video_gen reference image URLs use a 7200 second minimum TTL in
# the worker even when ENGINE_S3_PRESIGN_TTL is lower.
ENGINE_APIMART_API_KEY=
ENGINE_APIMART_BASE_URL=https://api.apimart.ai/v1
ENGINE_APIMART_IMAGE_MODEL=gpt-image-2
ENGINE_APIMART_VIDEO_MODEL=doubao-seedance-2.0
ENGINE_APIMART_REQUEST_TIMEOUT_SECONDS=60
ENGINE_APIMART_POLL_INITIAL_DELAY_SECONDS=10
ENGINE_APIMART_POLL_INTERVAL_SECONDS=4
ENGINE_APIMART_TIMEOUT_SECONDS=180
ENGINE_APIMART_VIDEO_POLL_INITIAL_DELAY_SECONDS=30
ENGINE_APIMART_VIDEO_POLL_INTERVAL_SECONDS=10
ENGINE_APIMART_VIDEO_TIMEOUT_SECONDS=900
ENGINE_IMAGE_PROVIDER_TIMEOUT_SECONDS=240

# ---- OpenAI image generation/edit fallback ----
# Do not commit real keys. OPENAI_LOCAL_PROXY is optional for local network routing.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_LOCAL_PROXY=
OPENAI_IMAGE_TIMEOUT=120
