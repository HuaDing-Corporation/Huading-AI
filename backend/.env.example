DATABASE_URL=postgresql+psycopg://huading:huading@localhost:5432/huading
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false
# JWT_SECRET_KEY must be set in every deployed environment.
# Use a high-entropy secret (32+ bytes); do not reuse this comment as a value.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=.local-storage
STORAGE_BUCKET=huading-dev
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1

# ---- Video engine (keys injected here, never hardcoded) ----
ENGINE_LLM_API_KEY=
ENGINE_LLM_BASE_URL=https://api.deepseek.com
ENGINE_LLM_MODEL=deepseek-v4-flash
ENGINE_DASHSCOPE_API_KEY=
ENGINE_DEFAULT_TEMPLATE=1080x1920/static_default.html
# "chrome"/"msedge" to use a system browser; empty = Playwright bundled Chromium
ENGINE_BROWSER_CHANNEL=
ENGINE_RUNTIME_ROOT=
ENGINE_OUTPUT_PREFIX=videos

# ---- Doubao-Seedance video (Volcengine Ark) — text-to-video / image-to-video ----
# Read by the engine video provider and scripts/run_seedance.py. Never hardcode.
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-260128
# Same provider for the API/worker (seedance_t2v / seedance_i2v video_mode).
ENGINE_SEEDANCE_API_KEY=
ENGINE_SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ENGINE_SEEDANCE_MODEL=doubao-seedance-2-0-260128
