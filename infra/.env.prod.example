# Copy to infra/.env on the Hong Kong server and fill real values there.
# This file is placeholders only. Do not commit real keys.

POSTGRES_DB=huading
POSTGRES_USER=huading
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://huading:<fill-postgres-password>@postgres:5432/huading

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_SECRET_KEY=
