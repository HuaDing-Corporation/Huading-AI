# Copy to infra/.env, then fill in the values marked REQUIRED below.
#   cd infra && cp .env.example .env
# Used by docker-compose.full.yml (backend + worker read these as container env).

# ── REQUIRED: JWT signing secret (32+ characters) ──────────────────────────
# The placeholder below is long enough to boot for throwaway LOCAL use only.
# Replace it with a high-entropy secret for anything shared or deployed.
JWT_SECRET_KEY=change-me-to-a-32+char-random-secret-string

# ── REQUIRED for real video generation (the engine LLM) ────────────────────
# Leave empty and the API still runs, but a generation task fails at the engine
# credential check. Fill these to actually produce a 成片.
ENGINE_LLM_API_KEY=
ENGINE_LLM_BASE_URL=https://api.deepseek.com
ENGINE_LLM_MODEL=deepseek-v4-flash

# ── Optional ───────────────────────────────────────────────────────────────
# DashScope key (only needed for image/video templates, not the static default).
ENGINE_DASHSCOPE_API_KEY=
# Leave empty to use the Playwright Chromium bundled in the backend image.
ENGINE_BROWSER_CHANNEL=
# Host port the backend is published on (default 8000). If you change it, set
# NEXT_PUBLIC_API_BASE_URL below to the same port.
BACKEND_PORT=8000

# Browser-side API base. The browser runs on your host, so it reaches the
# backend through the published host port, not the internal service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
UPLOAD_MAX_BYTES=10485760

# Object storage for generated videos (MinIO/S3-compatible).
# Defaults below keep the local MinIO e2e path working. For real OmniHuman e2e,
# switch to public Volcengine TOS so Jimeng can fetch presigned avatar/audio URLs:
#   ENGINE_S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
#   ENGINE_S3_PUBLIC_ENDPOINT=https://tos-s3-cn-beijing.volces.com
#   ENGINE_S3_SECURE=true
#   ENGINE_S3_ACCESS_KEY=<volcengine-ak>
#   ENGINE_S3_SECRET_KEY=<volcengine-sk>
#   ENGINE_S3_BUCKET=huading-media
#   ENGINE_S3_REGION=cn-beijing
#   ENGINE_S3_ADDRESSING_STYLE=virtual
ENGINE_S3_ENDPOINT=http://minio:9000
ENGINE_S3_PUBLIC_ENDPOINT=http://localhost:9000
ENGINE_S3_ACCESS_KEY=huading
ENGINE_S3_SECRET_KEY=change-me-to-a-32+char-random-minio-secret
ENGINE_S3_BUCKET=huading-videos
ENGINE_S3_REGION=us-east-1
ENGINE_S3_SECURE=false
# MinIO uses path-style; Volcengine TOS requires virtual-hosted-style.
ENGINE_S3_ADDRESSING_STYLE=path
ENGINE_S3_PRESIGN_TTL=3600
MINIO_ROOT_USER=huading
MINIO_ROOT_PASSWORD=change-me-to-a-32+char-random-minio-secret

# Doubao-Seedance / Ark worker guardrails.
ENGINE_SEEDANCE_REQUEST_TIMEOUT_SECONDS=120
ENGINE_SEEDANCE_POLL_INTERVAL_SECONDS=5
ENGINE_SEEDANCE_TIMEOUT_SECONDS=600

# Doubao Seed-TTS. Optional: empty values keep CI/dev on edge-tts fallback.
ENGINE_DOUBAO_TTS_APPID=
ENGINE_DOUBAO_TTS_ACCESS_TOKEN=
# Optional newer auth mode. If set, provider sends X-Api-Key instead of appid/access token.
ENGINE_DOUBAO_TTS_API_KEY=
ENGINE_DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
ENGINE_DOUBAO_TTS_DEFAULT_VOICE=zh_male_m191_uranus_bigtts
ENGINE_DOUBAO_TTS_REQUEST_TIMEOUT_SECONDS=60

# ── Optional: package mirrors for the backend image build (restricted networks) ──
# Leave empty to use upstream (deb.debian.org / pypi.org / playwright CDN).
# Example for CN networks:
#   APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
#   UV_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
#   PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
APT_MIRROR=
UV_INDEX=
PLAYWRIGHT_DOWNLOAD_HOST=
