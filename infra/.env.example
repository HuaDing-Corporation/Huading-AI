# Copy to infra/.env, then fill in the values marked REQUIRED below.
#   cd infra && cp .env.example .env
# Used by docker-compose.full.yml (backend + worker read these as container env).

# ── REQUIRED: JWT signing secret (32+ characters) ──────────────────────────
# The placeholder below is long enough to boot for throwaway LOCAL use only.
# Replace it with a high-entropy secret for anything shared or deployed.
JWT_SECRET_KEY=change-me-to-a-32+char-random-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENGINE_PLATFORM_TENANT_SLUGS=
ENGINE_ORPHAN_TASK_STALE_SECONDS=1800
ENGINE_ORPHAN_RECOVERY_INTERVAL_SECONDS=60

# ── REQUIRED for real video generation (the engine LLM) ────────────────────
# Leave empty and the API still runs, but a generation task fails at the engine
# credential check. Fill these to actually produce a 成片.
ENGINE_LLM_API_KEY=
ENGINE_LLM_BASE_URL=https://api.deepseek.com
ENGINE_LLM_MODEL=deepseek-v4-flash
ENGINE_DEEPSEEK_CNY_PER_1K_INPUT=0.001008
ENGINE_DEEPSEEK_CNY_PER_1K_OUTPUT=0.002016

# ── Optional ───────────────────────────────────────────────────────────────
# DashScope key (only needed for image/video templates, not the static default).
ENGINE_DASHSCOPE_API_KEY=
# Leave empty to use the Playwright Chromium bundled in the backend image.
ENGINE_BROWSER_CHANNEL=
# Host port the backend is published on (default 8000). If you change it, set
# NEXT_PUBLIC_API_BASE_URL below to the same port.
BACKEND_PORT=8000

# Browser-side API base. The browser runs on your host, so it reaches the
# backend through the published host port, not the internal service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
UPLOAD_MAX_BYTES=10485760

# Object storage for generated videos (MinIO/S3-compatible).
# Defaults below keep the local MinIO e2e path working. For real OmniHuman e2e,
# switch to public Volcengine TOS so Jimeng can fetch presigned avatar/audio URLs:
#   ENGINE_S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
#   ENGINE_S3_PUBLIC_ENDPOINT=https://tos-s3-cn-beijing.volces.com
#   ENGINE_S3_SECURE=true
#   ENGINE_S3_ACCESS_KEY=<volcengine-ak>
#   ENGINE_S3_SECRET_KEY=<volcengine-sk>
#   ENGINE_S3_BUCKET=huading-media
#   ENGINE_S3_REGION=cn-beijing
#   ENGINE_S3_ADDRESSING_STYLE=virtual
ENGINE_S3_ENDPOINT=http://minio:9000
ENGINE_S3_PUBLIC_ENDPOINT=http://localhost:9000
ENGINE_S3_ACCESS_KEY=huading
ENGINE_S3_SECRET_KEY=change-me-to-a-32+char-random-minio-secret
ENGINE_S3_BUCKET=huading-videos
ENGINE_S3_REGION=us-east-1
ENGINE_S3_SECURE=false
# MinIO uses path-style; Volcengine TOS requires virtual-hosted-style.
ENGINE_S3_ADDRESSING_STYLE=path
ENGINE_S3_PRESIGN_TTL=3600
# Producer name embedded in generated MP4 AIGC metadata.
ENGINE_AIGC_PRODUCER=Huading
# Seed the royalty-free BGM library into DB/object storage during backend startup.
ENGINE_BGM_SEED_ON_STARTUP=true
MINIO_ROOT_USER=huading
MINIO_ROOT_PASSWORD=change-me-to-a-32+char-random-minio-secret

# Doubao-Seedance / Ark worker guardrails.
ENGINE_SEEDANCE_REQUEST_TIMEOUT_SECONDS=120
ENGINE_SEEDANCE_POLL_INTERVAL_SECONDS=5
ENGINE_SEEDANCE_TIMEOUT_SECONDS=1500

# Volcengine Jimeng OmniHuman request and overall wait guardrails.
ENGINE_OMNIHUMAN_REQUEST_TIMEOUT_SECONDS=120
ENGINE_OMNIHUMAN_POLL_INTERVAL_SECONDS=5
ENGINE_OMNIHUMAN_TIMEOUT_SECONDS=1500
# Direct provider cost booking.
ENGINE_OMNIHUMAN_CNY_PER_SEC=1.0
ENGINE_OMNIHUMAN_CHANGE_LIPS_LITE_REQ_KEY=realman_change_lips
ENGINE_OMNIHUMAN_CHANGE_LIPS_BASIC_REQ_KEY=realman_change_lips_basic_chimera
ENGINE_OMNIHUMAN_CHANGE_LIPS_REGION=cn-beijing
ENGINE_OMNIHUMAN_CHANGE_LIPS_LITE_CNY_PER_SEC=0.3
ENGINE_OMNIHUMAN_CHANGE_LIPS_BASIC_CNY_PER_SEC=1.05
ENGINE_OMNIHUMAN_CHANGE_LIPS_DEFAULT_TIER=basic
ENGINE_OMNIHUMAN_CHANGE_LIPS_OPEN_SR=true
ENGINE_OMNIHUMAN_CHANGE_LIPS_BASIC_RETRY_ON_SHORT_OUTPUT=false

# Doubao Seed-TTS. Optional: empty values keep CI/dev on edge-tts fallback.
ENGINE_DOUBAO_TTS_APPID=
ENGINE_DOUBAO_TTS_ACCESS_TOKEN=
# Optional newer auth mode. If set, provider sends X-Api-Key instead of appid/access token.
ENGINE_DOUBAO_TTS_API_KEY=
ENGINE_DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
ENGINE_DOUBAO_TTS_DEFAULT_VOICE=zh_male_m191_uranus_bigtts
ENGINE_DOUBAO_TTS_REQUEST_TIMEOUT_SECONDS=60
# Default false avoids audible Seed-TTS watermark tails; set true only to force provider watermarking.
ENGINE_DOUBAO_TTS_AIGC_WATERMARK=false
ENGINE_SEEDTTS_CNY_PER_CHAR=0.0003

# APIMart image/video generation for the default photo and video_gen providers.
# APIMart pulls edit/reference images from ENGINE_S3_PUBLIC_ENDPOINT presigned URLs.
ENGINE_APIMART_API_KEY=
ENGINE_APIMART_BASE_URL=https://api.apimart.ai/v1
ENGINE_APIMART_IMAGE_MODEL=gpt-image-2
ENGINE_APIMART_VIDEO_MODEL=doubao-seedance-2.0
ENGINE_APIMART_SCENE_PROMPT_MODEL=gpt-5.6-luna
ENGINE_APIMART_SCENE_PROMPT_INPUT_USD_PER_M=1.0
ENGINE_APIMART_SCENE_PROMPT_OUTPUT_USD_PER_M=6.0
ENGINE_AIBRAIN_LOW_INPUT_CREDITS_PER_1K=1.73
ENGINE_AIBRAIN_LOW_OUTPUT_CREDITS_PER_1K=10.37
ENGINE_AIBRAIN_MID_INPUT_CREDITS_PER_1K=4.32
ENGINE_AIBRAIN_MID_OUTPUT_CREDITS_PER_1K=25.92
ENGINE_AIBRAIN_HIGH_INPUT_CREDITS_PER_1K=8.64
ENGINE_AIBRAIN_HIGH_OUTPUT_CREDITS_PER_1K=51.84
ENGINE_AIBRAIN_LOW_INPUT_PROVIDER_CREDITS_PER_M=8
ENGINE_AIBRAIN_LOW_OUTPUT_PROVIDER_CREDITS_PER_M=48
ENGINE_AIBRAIN_MID_INPUT_PROVIDER_CREDITS_PER_M=20
ENGINE_AIBRAIN_MID_OUTPUT_PROVIDER_CREDITS_PER_M=120
ENGINE_AIBRAIN_HIGH_INPUT_PROVIDER_CREDITS_PER_M=40
ENGINE_AIBRAIN_HIGH_OUTPUT_PROVIDER_CREDITS_PER_M=240
ENGINE_AIBRAIN_MAX_COMPLETION_TOKENS=4096
ENGINE_AIBRAIN_RESERVATION_STALE_MINUTES=30
ENGINE_APIMART_REQUEST_TIMEOUT_SECONDS=60
ENGINE_APIMART_POLL_INITIAL_DELAY_SECONDS=10
ENGINE_APIMART_POLL_INTERVAL_SECONDS=4
ENGINE_APIMART_TIMEOUT_SECONDS=1500
ENGINE_APIMART_VIDEO_POLL_INITIAL_DELAY_SECONDS=30
ENGINE_APIMART_VIDEO_POLL_INTERVAL_SECONDS=10
ENGINE_APIMART_VIDEO_TIMEOUT_SECONDS=1500
ENGINE_REVERSE_PROMPT_VIDEO_CREDITS=100
# Actual APIMart cost booking: credits -> USD -> CNY cents.
ENGINE_APIMART_CREDIT_USD=0.10
ENGINE_USD_CNY_RATE=7.2
ENGINE_IMAGE_PROVIDER_TIMEOUT_SECONDS=1500

# OpenAI image generation/edit fallback. Do not commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_LOCAL_PROXY=
OPENAI_IMAGE_TIMEOUT=1500

# ── Optional: package mirrors for the backend image build (restricted networks) ──
# Leave empty to use upstream (deb.debian.org / pypi.org / playwright CDN).
# Only set mirrors after explicitly reviewing them for the target network.
APT_MIRROR=
UV_INDEX=
PLAYWRIGHT_DOWNLOAD_HOST=
